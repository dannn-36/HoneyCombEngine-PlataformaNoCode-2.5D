@startuml editor-components
title Editor - Componentes y limites de responsabilidad
top to bottom direction
skinparam componentStyle rectangle

package "Proceso Electron renderer" as renderer {
  package "Shell" as shell {
    component "App\nAngular component (shell)\nestado de la ventana y cableado" as app
    component "MenuBar\nmenus y atajos" as menuBar
    component "PanelsController\nNamePromptController" as uiCtl
  }

  package "Escena" as scene {
    component "ViewportController\ncanvas isometrico,\nzoom, arrastre, pintado" as viewport
    component "IsoCanvasRenderer\nSpriteCache" as renderer2d
    component "SelectionController\nEntityOpsController\nPaletteController" as sceneOps
    component "InspectorController\nBackgroundPickerController" as inspector
    component "MapController\nsalas y tuneles" as map
    component "FloorController\npisos por capas" as floor
  }

  package "Contenido" as content {
    component "EventsController\neventos NoCode" as eventsCtl
    component "TransitionController\npasar de nivel" as transition
    component "CharactersController\npersonajes del proyecto" as characters
    component "ItemEditorController\nItemsPanelController\nCombatInspectorController\nPuzzleController" as combat
    component "AttackPreviewDirective" as attackPreview
  }

  package "Recursos" as resources {
    component "TexturesController\nTextureThumbDirective" as texLib
    component "ImageConverterController\nPNG/JPG -> PNG" as converter
    component "SoundsController\nimportar y escuchar" as sounds
    component "SpriteEditorController\nherramienta de sprites" as spriteEditor
  }

  package "Proyecto" as projectPkg {
    component "ProjectController\nabrir, guardar, recuperar,\nexportar" as projectCtl
    component "ExplorerController\narbol de archivos" as explorer
    component "EngineController\nmotor Debug / Release,\ncompilar, Ejecutar" as engineCtl
    component "GameConfigController\ngame.json" as gameCfg
    component "JsonViewController\nvista del JSON" as jsonView
  }

  package "dialogs/ (cargados con @defer)" as dialogs {
    component "DialogBase\nEDITOR_HOST" as dialogBase
    component "Sala, Tunel, Personajes,\nObjetos y armas, Pasar de nivel,\nConvertidor, Puzzle,\nConfiguracion del juego,\nSpriteEditor" as dialogViews
  }

  package "services/ (estado)" as services {
    component "LevelService\nnivel abierto" as levelService
    component "LevelHistoryService\ndeshacer / rehacer" as history
    component "SelectionService" as selection
    component "CatalogService\ncatalogo de eventos" as catalog
    component "ItemLibraryService\nCharacterPresetService\nGameConfigService" as libraries
    component "ThemeService" as theme
    component "ProjectService\nfachada tipada del disco;\ndetecta cambios de afuera" as projectService
  }

  component "core/ (logica pura, con tests)\niso-projection, dungeon-layout, floors,\nitems, puzzles, characters, entity-refs,\nlevel-diff, undo-history, sprite-doc,\ntexture-fit, file-names, game-config, camera" as core
  component "Modelos TypeScript\nLevel / ItemDef / GameConfig /\nEventCatalog / CharacterPreset" as models
}

component "preload.js\ncontextBridge\nhoneycombProject" as preload

package "Proceso Electron main" as mainProcess {
  component "main.js\nventana, CSP y registro de IPC" as main
  package "ipc/ (un modulo por dominio)" as ipc {
    component "project-root.js\ncarpeta del editor y\nbarrera de rutas" as root
    component "workspace.js\ncambiar / crear proyecto,\ncatalogo de eventos" as workspace
    component "files.js + safe-write.js\nleer, listar, escribir\natomico con .bak" as filesIpc
    component "levels.js\nabrir / importar nivel" as levelsIpc
    component "convert.js, textures.js,\nsounds.js, names.js,\nmedia-types.js" as assetsIpc
    component "level-check.js\nAjv contra level.schema" as levelCheck
    component "recovery.js\ncopia del nivel sin guardar" as recovery
    component "engine-modes.js + engine-build.js\nDebug / Release, CMake" as engineBuild
    component "run.js\nlanzar engine.exe" as runIpc
    component "export.js + zip.js + exe-icon.js\nexportar el juego" as exportIpc
  }
}

folder "Carpeta del editor" as disk {
  file "levels/*.json" as levelFiles
  file "game.json\nitems.json\ncharacters.json" as projectFiles
  folder "assets/textures\nassets/sounds" as assetFiles
  folder "saves/" as saves
}
folder "Datos de Electron" as userData {
  file "honeycomb-settings.json" as settings
  folder "recuperacion/" as recoveryDir
}
folder "Instalacion" as install {
  file "schema/*.json" as schemaFiles
  file "engine/build\nengine/build-release" as engineExe
}
folder "Destino de la exportacion" as exportDir

app --> menuBar
app --> uiCtl
app --> scene
app --> content
app --> resources
app --> projectPkg
app --> dialogs : @defer (when ...)
dialogViews --> dialogBase
dialogBase --> app : controladores\npor EDITOR_HOST
viewport --> renderer2d
viewport --> core
map --> core
floor --> core
combat --> attackPreview
scene --> levelService
content --> levelService
content --> libraries
eventsCtl --> catalog
sceneOps --> selection
projectCtl --> levelService
projectCtl --> history
gameCfg --> libraries
levelService --> history
levelService --> models
levelService --> core
history --> core
services --> projectService
resources --> projectService
projectCtl --> projectService
engineCtl --> projectService
projectService --> preload : honeycombProject API
preload --> main : ipcRenderer.invoke
main --> ipc
workspace --> root
filesIpc --> root
levelsIpc --> root
assetsIpc --> root
runIpc --> root
exportIpc --> root
root --> disk : rutas relativas validadas
root --> settings
recovery --> recoveryDir
levelCheck --> schemaFiles
workspace --> schemaFiles
engineBuild --> engineExe
runIpc --> engineExe
exportIpc --> engineExe : copia el Release
exportIpc --> exportDir

note right of preload
Boundary de seguridad:
contextIsolation=true
nodeIntegration=false
API minima expuesta al renderer.
Ninguna ruta puede salir de la
carpeta del editor; los destinos de
afuera (exportar, importar) los elige
un dialogo del proceso main.
end note

note bottom of content
Controladores y no componentes: el ESTADO vive en
los controladores de App. Los dialogos grandes de
dialogs/ son componentes solo por peso (se cargan
con @defer) y usan los controladores de App; por eso
app.scss no esta encapsulado.
Un objeto o personaje usado por el nivel se COPIA a la
entidad o a "items" del nivel: el nivel no depende de
items.json ni de characters.json.
end note
@enduml
