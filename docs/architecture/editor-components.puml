@startuml editor-components
title Editor - Componentes y limites de responsabilidad
top to bottom direction
skinparam componentStyle rectangle

package "Proceso Electron renderer" as renderer {
  component "App\nAngular component (shell)" as app
  component "Canvas isometrico\nrender y entrada" as canvas
  component "Paneles y formularios\n(app.html)" as panels
  package "dialogs/ (cargados con @defer)" as dialogs {
    component "DialogBase\nEDITOR_HOST + helpers" as dialogBase
    component "Objetos y armas, Personajes,\nConvertidor, Puzzle, Grilla,\nTunel, Pasar de nivel" as dialogViews
  }
  package "combat/" as combat {
    component "ItemEditorController\nventana Objetos y armas" as itemEditor
    component "CombatInspectorController\npanel Combate / Tienda" as combatInspector
    component "PuzzleController\ndialogo Puzzle de sala" as puzzle
    component "AttackPreviewDirective\nforma del ataque en canvas" as attackPreview
  }
  package "textures/" as textures {
    component "TexturesController\nbiblioteca y miniaturas\nbajo demanda" as texLib
    component "TextureThumbDirective\npide la miniatura\nal entrar en pantalla" as thumb
    component "ImageConverterController\nPNG/JPG/JPEG -> PNG" as converter
  }
  component "ProjectController\nnivel como documento,\nGuardar como" as projectCtl
  component "NamePromptController\npedir un nombre" as namePrompt
  component "core/items.ts\ndefaults, validacion,\ncopia al nivel" as itemsCore
  component "core/puzzles.ts\neventos de un puzzle" as puzzlesCore
  component "core/texture-fit.ts\ntamano y formato\nde las texturas" as textureFit
  component "core/file-names.ts\nnombres seguros" as fileNames
  component "LevelService\nestado del nivel" as levelService
  component "CatalogService\ncatalogo de eventos" as catalogService
  component "ItemLibraryService\nbiblioteca de objetos" as itemLibrary
  component "ProjectService\nfachada tipada" as projectService
  component "IsoProjection\nproyeccion de coordenadas" as projection
  component "Modelos TypeScript\nLevel / ItemDef / EventCatalog" as models
}

component "preload.js\ncontextBridge" as preload

package "Proceso Electron main" as mainProcess {
  component "main.js\nventana y registro de IPC" as main
  package "ipc/ (un modulo por dominio)" as ipc {
    component "project-root.js\ncarpeta del editor y\nbarrera de rutas" as root
    component "workspace.js\ncual es, cambiarla,\ncatalogo de eventos" as workspace
    component "levels.js\nabrir / importar nivel" as levelsIpc
    component "files.js\nleer, escribir, listar,\ncrear carpetas" as filesIpc
    component "convert.js\nimportar imagenes" as convertIpc
    component "run.js\nlanzar engine.exe" as runIpc
    component "names.js\nnombres seguros y libres" as names
  }
  component "fs/promises\nacceso a archivos" as fs
}

folder "Carpeta del editor" as disk {
  file "levels/*.json" as levelFiles
  file "items.json" as itemsFile
  file "characters.json" as charactersFile
  folder "assets/textures\nassets/sounds" as textureFiles
}
folder "Instalacion" as install {
  file "schema/event_catalog.json" as eventFile
  file "engine/.../engine.exe" as engineExe
}

app --> canvas
app --> panels
app --> dialogs : @defer (when ...)
dialogViews --> dialogBase
dialogBase --> app : controladores\npor EDITOR_HOST
app --> itemEditor
app --> combatInspector
app --> puzzle
app --> projectCtl
app --> converter
app --> texLib
dialogViews --> attackPreview
panels --> thumb
dialogViews --> thumb
thumb --> texLib
texLib --> textureFit
converter --> textureFit
projectCtl --> namePrompt
projectCtl --> fileNames
projectCtl --> levelService
app --> levelService
app --> catalogService
itemEditor --> itemLibrary
itemEditor --> itemsCore
combatInspector --> levelService
combatInspector --> itemLibrary
puzzle --> puzzlesCore
puzzle --> levelService
attackPreview --> itemsCore
canvas --> projection
levelService --> models
levelService --> itemsCore
catalogService --> models
itemLibrary --> projectService
levelService --> projectService
catalogService --> projectService
texLib --> projectService
converter --> projectService
projectService --> preload : honeycombProject API
preload --> main : ipcRenderer.invoke
main --> ipc
workspace --> root
levelsIpc --> root
levelsIpc --> names
filesIpc --> root
convertIpc --> root
convertIpc --> names
runIpc --> root
root --> fs
fs --> disk : rutas relativas validadas
workspace --> eventFile
runIpc --> engineExe

note right of preload
Boundary de seguridad:
contextIsolation=true
nodeIntegration=false
API minima expuesta al renderer.
Ninguna ruta puede salir de la
carpeta del editor.
end note

note bottom of combat
Controladores y no componentes: el ESTADO vive en
los controladores de App. Los dialogos grandes de
dialogs/ son componentes solo por peso (se cargan
con @defer) y usan los controladores de App; por eso
app.scss no esta encapsulado.
Un objeto usado por el nivel se COPIA a "items"
del nivel: el nivel no depende de items.json.
end note
@enduml
