@startuml runtime-deployment
title Runtime - Despliegue
left to right direction
skinparam componentStyle rectangle

actor "Disenador" as designer
actor "Jugador" as player

node "Equipo del disenador (desde el editor)" as devMachine {
  node "Proceso runtime" as devProcess {
    component "engine/build/engine.exe\nDebug: panel F3, F1/F2, F8" as debugExe
    component "engine/build-release/engine.exe\nRelease: -O3, sin herramientas" as releaseExe
  }
  folder "Carpeta del editor" as project {
    folder "levels/" as levels
    folder "assets/" as assets
    file "game.json" as gameJson
    folder "saves/\nprueba.json (Ejecutar)\npartida.json (portada)" as devSaves
  }
}

node "Equipo del jugador (juego exportado)" as playerMachine {
  folder "<Juego>/" as gameDir {
    component "<Juego>.exe\n(motor Release renombrado,\nsin consola, con su icono)" as gameExe
    component "SDL2 y DLLs de MinGW" as dlls
    file "honeycomb-export.json\n(marca)" as mark
    folder "levels/ assets/ game.json" as gameData
  }
  folder "%APPDATA%\\<Juego>\\saves" as userSaves
}

designer --> debugExe : Ejecutar (nivel absoluto)
designer --> releaseExe : Ejecutar con Release
debugExe --> levels : lee JSON
debugExe --> assets : {nivel}/../../assets
debugExe --> gameJson : ventana, portada, HUD
debugExe --> devSaves : guarda / continua
player --> gameExe : doble clic: arranca en la portada
gameExe --> dlls
gameExe --> mark : detecta que es un juego exportado
gameExe --> gameData : lee niveles y assets
gameExe --> userSaves : partida guardada

note bottom of project
El directorio de trabajo se fija a la carpeta
del ejecutable al iniciar main.cpp; el nivel
llega por argumento con su ruta absoluta.
end note

note bottom of gameDir
Si no puede arrancar, lo dice en una ventana:
el jugador no ve la consola.
end note
@enduml
