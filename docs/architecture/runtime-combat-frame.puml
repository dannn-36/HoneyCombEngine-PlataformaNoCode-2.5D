@startuml runtime-combat-frame
title Runtime - Combate, objetos y puzzles en un frame
skinparam sequenceMessageAlign center

participant "GameSession" as main
participant "InputSystem" as input
participant "Mobility" as mobility
participant "Combat" as combat
participant "Loot" as loot
participant "EventSystem\n+ EventBindings" as events
participant "CombatView\n+ HealthHud" as view

main -> input : mouse -> celda apuntada\n(IsoGridSystem::ScreenToGridContinuous)

alt tienda abierta
  main -> loot : Buy(1..9) / E cierra
else dialogo abierto (show_dialog)
  main -> input : E / Enter / Espacio avanza el dialogo\n(el juego queda congelado mientras tanto)
else juego normal
  main -> input : 1-9 / rueda = arma activa
  main -> mobility : UpdatePlayer(caminar, Shift esquive, K defensa)
  mobility --> main : defending, i-frames
  main -> combat : Update(intent: aim, atacar, Q, defensa, i-frames)
  activate combat
  combat -> combat : ataque del arma activa\n(linea / area / cono / proyectil / area remota / explosivo)
  combat -> combat : acierto -> contador de habilidad +1\nlleno -> habilidad (auto o Q)
  combat -> combat : proyectiles y areas pendientes
  combat -> combat : IA: perseguir, atacar con arma o por contacto
  combat --> main : caidos, habilidades usadas, jugador vencido
  deactivate combat
  main -> loot : RollDrops(caidos)
  main -> loot : UpdatePickups(E = cambiar arma)\nNearbyShop(E = abrir tienda)
  main -> main : CheckCheckpoints() -> Progress::Write
end

main -> events : Update()
note right of events
Triggers: on_level_start, on_timer, on_key_pressed,
on_interact, on_collision, on_entity_destroyed,
on_all_enemies_defeated, on_zone_cleared, on_boss_defeated,
on_items_collected, on_player_enter_zone, on_ability_used.
Condiciones: marcas, variables, objetos, monedas, zona.
Acciones: show_entity / hide_entity (puertas), spawn_entity,
move_entity, give_item, add_coins, heal_player,
set_inventory_slots, set/add_variable, save_game,
show_message, show_dialog, play_sound, play_music,
shake_camera, wait, load_level...
Las recompensas no se repiten al continuar una partida.
end note

main -> view : SubmitGroundItems (ZSort)
main -> view : DrawEffects, DrawProjectiles
main -> view : HealthHud (estilo de game.json),\nDrawHud (inventario, monedas, esquive,\njefe, avisos), DrawShop, dialogo
@enduml
