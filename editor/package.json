{
  "name": "editor",
  "version": "0.1.0",
  "description": "Editor NoCode de juegos isométricos 2.5D",
  "author": "HoneyComb Engine",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ipc": "node --test \"ipc/tests/**/*.test.js\"",
    "electron": "electron .",
    "dev": "node scripts/dev.js",
    "icons": "node scripts/build-icons.mjs",
    "installer": "node scripts/build-installer.js"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "ajv": "^8.20.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^28.0.0",
    "lucide-static": "^1.58.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "build": {
    "appId": "HoneyComb.Engine.Editor",
    "productName": "HoneyComb Engine",
    "extraMetadata": {
      "productName": "HoneyComb Engine"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "ipc/**/*",
      "!ipc/tests{,/**/*}",
      "public/favicon.ico",
      "public/icon.png",
      "dist/editor/browser/**/*",
      "dist/editor/3rdpartylicenses.txt",
      "!node_modules/@angular{,/**/*}",
      "!node_modules/@fontsource{,/**/*}",
      "!node_modules/rxjs{,/**/*}",
      "!node_modules/tslib{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "../engine/build",
        "to": "engine/build",
        "filter": ["engine.exe", "*.dll"]
      },
      {
        "from": "../engine/build-release",
        "to": "engine/build-release",
        "filter": ["engine.exe", "*.dll"]
      },
      {
        "from": "../schema",
        "to": "schema"
      },
      {
        "from": "../levels",
        "to": "levels"
      },
      {
        "from": "../assets",
        "to": "assets"
      },
      {
        "from": "../characters.json",
        "to": "characters.json"
      },
      {
        "from": "../items.json",
        "to": "items.json"
      }
    ],
    "electronLanguages": ["es", "es-419", "en-US"],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "HoneyComb Engine",
      "uninstallDisplayName": "HoneyComb Engine",
      "installerLanguages": ["es_ES"],
      "language": "3082",
      "artifactName": "HoneyComb-Engine-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    }
  }
}
